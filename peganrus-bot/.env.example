# --- Telegram ---
BOT_TOKEN=
ADMIN_BOT_TOKEN=
# Свой Telegram ID (число). Если 0 — админ-бот покажет ваш ID при первом сообщении.
ADMIN_TELEGRAM_ID=0

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TEMPERATURE=0.7
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=120
# DEEPSEEK_RETRIES=3
# DEEPSEEK_RETRY_DELAY=3
# Цены за 1 млн токенов (USD) для примерной оценки стоимости в админке
# DEEPSEEK_PRICE_INPUT_MISS=0.28
# DEEPSEEK_PRICE_INPUT_HIT=0.028
# DEEPSEEK_PRICE_OUTPUT=0.42

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/peganrus_db
# Применять миграции и стартовые данные автоматически при запуске
# AUTO_MIGRATE=true

# --- Robokassa (заглушка) ---
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# --- Бизнес-логика ---
SUBSCRIPTION_PRICE=400
# SUBSCRIPTION_DAYS=30
LIMIT_TRIAL=30
DAILY_LIMIT_PAID=100

# --- Прочее (необязательно, значения по умолчанию в app/config.py) ---
# TIMEZONE=Europe/Moscow
# MAX_MESSAGE_LENGTH=500
# ANTIFLOOD_SECONDS=3
# TELEGRAM_CHUNK_LENGTH=2096
# COMPRESSION_KEEP_LAST=5
