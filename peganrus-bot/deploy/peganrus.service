[Unit]
Description=Peganrus Telegram bots
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=peganrus
WorkingDirectory=/opt/peganrus-bot
ExecStart=/opt/peganrus-bot/.venv/bin/python -m app.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
